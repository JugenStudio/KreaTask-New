// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String // In a real app, this should be a hash
  avatarUrl     String?
  role          UserRole       @default(UNASSIGNED)
  jabatan       String         @default("Unassigned")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         Task[]         @relation("TaskToUser")
  revisions     Revision[]
  comments      Comment[]
  notifications Notification[]
}

model Task {
  id              String        @id
  titleEn         String
  titleId         String
  descriptionEn   String        @db.Text
  descriptionId   String        @db.Text
  status          String
  category        TaskCategory
  dueDate         DateTime
  value           Int
  valueCategory   ValueCategory
  evaluator       Evaluator
  approvedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  assigneeId      String?
  assignees       User[]        @relation("TaskToUser")
  revisions       Revision[]
  comments        Comment[]
  files           File[]
  subtasks        Subtask[]
  notifications   Notification[]

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id        String   @id
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Comment {
  id         String   @id
  contentEn  String   @db.Text
  contentId  String   @db.Text
  isPinned   Boolean  @default(false)
  timestamp  DateTime @default(now())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model Revision {
  id        String   @id
  changeEn  String   @db.Text
  changeId  String   @db.Text
  timestamp DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model File {
  id     String  @id
  name   String
  type   String
  url    String  @db.Text
  size   String
  note   String? @db.Text
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Subtask {
  id          String  @id
  title       String
  isCompleted Boolean @default(false)
  taskId      String
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum UserRole {
  roles_super_admin
  roles_admin
  roles_team_leader
  roles_team_member
  UNASSIGNED
  JURNALIS
  SOCIAL_MEDIA_OFFICER
  DESAIN_GRAFIS
  MARKETING
  FINANCE
}

enum TaskCategory {
  Low
  Medium
  High
  Critical
}

enum ValueCategory {
  Rendah
  Menengah
  Tinggi
  Kritis
}

enum Evaluator {
  AI
  Direktur_Operasional
  Direktur_Bisnis
  Direktur_Utama
}
