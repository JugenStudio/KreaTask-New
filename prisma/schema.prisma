generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@id([provider, providerAccountId], map: "account_provider_providerAccountId_pk")
}

model comment {
  id        String   @id
  contentEn String?
  contentId String?
  isPinned  Boolean? @default(false)
  timestamp DateTime @default(now()) @db.Timestamp(6)
  authorId  String?
  taskId    String?
}

model file {
  id     String  @id
  name   String
  type   String? @db.VarChar(50)
  url    String
  size   String?
  note   String?
  taskId String?
}

model notification {
  id        String   @id
  message   String
  type      String?  @db.VarChar(50)
  read      Boolean? @default(false)
  link      String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  userId    String?
  taskId    String?
}

model revision {
  id        String   @id
  changeEn  String?
  changeId  String?
  timestamp DateTime @default(now()) @db.Timestamp(6)
  authorId  String?
  taskId    String?
}

model session {
  sessionToken String   @id
  userId       String
  expires      DateTime @db.Timestamp(6)
}

model subtask {
  id          String   @id
  title       String
  isCompleted Boolean? @default(false)
  taskId      String?
}

model task {
  id            String   @id
  titleEn       String
  titleId       String
  descriptionEn String?
  descriptionId String?
  status        String   @db.VarChar(50)
  category      String   @db.VarChar(50)
  dueDate       DateTime @db.Timestamp(6)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @db.Timestamp(6)
  value         Int
  valueCategory String?  @db.VarChar(50)
  evaluator     String?  @db.VarChar(100)
  approvedBy    String?
}

model tasks_to_users {
  task_id String
  user_id String

  @@id([task_id, user_id], map: "tasks_to_users_task_id_user_id_pk")
}

model user {
  id            String    @id
  name          String?
  email         String
  emailVerified DateTime? @db.Timestamp(6)
  image         String?
  role          String    @default("Unassigned")
  jabatan       String?
  password      String?
}

model verificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamp(6)

  @@id([identifier, token], map: "verificationToken_identifier_token_pk")
}
